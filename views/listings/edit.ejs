<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <body>
            <h3>Edit your Listing</h3>
            <form method="POST" action="/listings/<%=listing._id %>?_method=PUT">

            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" name="title" id="title" value="<%=listing.title%>" class="form-control">
            </div>

            <div class="mb-3">
                 <label for="description" class="form-label">Description</label>
                <textarea name="description" id="description" placeholder="enter description"><%= listing.description%></textarea>
            </div>
        
            <div class="mb-3">
                <label for="image" class="form-label">Image</label>
                <input type="text" name="image" id="image" value="<%=listing.image%>" placeholder="Enter image" class="form-control">
            </div> 
       
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="price" id="price" value="<%=listing.price%>" placeholder="enter price" class="form-control">
                </div>
        
                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="country" id="country"  value="<%=listing.country%>" placeholder="enter your country name" class="form-control">
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="text" name="location" id="location" value="<%=listing.location%>" placeholder="enter your location" class="form-control">
            </div>
            
            <button class="btn btn-dark edit-btn mt-3">Edit</button>
    </form>
</body>

    </div>
</div>