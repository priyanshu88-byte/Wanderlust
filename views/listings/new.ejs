<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">

        <h3>Create New Listing</h3>
        <form method="POST" action="/listings">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="title" id="title" placeholder="Add a catchy title" class="form-control">
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="description" id="description" placeholder="enter description" class="form-control" ></textarea>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Image-Link</label>
            <input type="text" name="image" id="image" placeholder="Enter image link" class="form-control">
        
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price</label>
                <input type="number" name="price" id="price" placeholder="1200" class="form-control">
            </div>
        
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Country</label>
                <input type="text" name="country" id="country" placeholder="Enter your country name" class="form-control">
            </div>
        </div>        

        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="location" id="location" placeholder="Enter location" class="form-control">
        </div>
        
        <button class="btn btn-dark add-btn mt-3">Add</button>
          </form>
        </div>
    </div>
</body>
