<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-3 mt-3">
    <body>
    <h3>Listing Details :</h3>
    </div>
    <div class="card col-6 offset-3">
        <img src="<%=listing.image %>" class="card-img-top show-img" alt="Listing_image">
        <div class="card-body">
            <p class="card-text"><b><%=listing.title %></b> <br>
            <%= listing.description %><br>
            <b>Price : </b>&#8377;<%= listing.price.toLocaleString("en-IN") %><br>
            <b>Location : </b><%= listing.location %><br>
            <b>Country</b> : <%= listing.country %><br>
            </p>
        </div> 
    </div>
    <div class="btns">
        <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark col-1 offset-3">Edit</a>
    <br><br>
    <form method="POST" action="/listings/<%=listing.id %>?_method=DELETE">
        <button class="btn btn-dark offset-5 edit-btn">Delete</button>
    </form>
    </div>
</body>
</div>